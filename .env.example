# ==============================================================================
# Document Intelligence & Question Extraction Service - Configuration Template
# ==============================================================================

# Application & API
PROJECT_NAME="Document Intelligence & Question Extraction Service"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
SECRET_KEY="super-secret-key-change-in-production-min-32-chars-length"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="document_intelligence"
# Async database URL for SQLAlchemy (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@db:5432/document_intelligence"
# Sync database URL for Alembic migrations (psycopg2)
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres_password@db:5432/document_intelligence"

# Redis & Celery
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/1"

# Storage Configuration
STORAGE_DIR="/app/storage/uploads"
MAX_FILE_SIZE_BYTES=26214400 # 25MB (25 * 1024 * 1024)

# OCR & AI Configuration
OCR_ENGINE="tesseract"
TESSERACT_CMD="/usr/bin/tesseract"
AI_PROVIDER="mock" # Options: mock | openai | gemini
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
